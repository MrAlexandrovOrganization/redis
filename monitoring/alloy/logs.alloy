stage.match {
	selector = `{service="redis/redis"}`

	stage.regex {
		expression = `^[0-9]+:[A-Z] [0-9]{2} [A-Z][a-z]{2} [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3} \* (?P<routine_redis_rdb>[0-9]+ changes in [0-9]+ seconds\. Saving\.\.\.|Background saving (started by pid [0-9]+|terminated with success)|Fork CoW for RDB: current [0-9]+ MB, peak [0-9]+ MB, average [0-9]+ MB|DB saved on disk)$`
	}

	stage.template {
		source   = "text_level"
		template = `{{ if .routine_redis_rdb }}debug{{ else }}{{ .Value }}{{ end }}`
	}
}
